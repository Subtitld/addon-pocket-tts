  "disk_required_mb": 300,
  "ram_required_mb": 1024,
  "config_schema": {
    "fields": [
      {
        "key": "model",
        "type": "select",
        "label": "Model",
        "default": "standard",
        "options": [
          {
            "value": "standard",
            "label": "Standard: 220 MB per language, about 3 times faster than real time"
          },
          {
            "value": "small",
            "label": "Small, English only: 112 MB, about twice as fast as Standard"
          },
          {
            "value": "large",
            "label": "Large preview: 670 MB per language (1.3 GB for English), about real time"
          }
        ],
        "help": "Small exists for English only; other languages use Standard with it. Kyutai's large models are previews: in our test they made no fewer mistakes than Standard, at a third of the speed. Listen before you dub a whole film with them."
      },
      {
        "key": "quantize",
        "type": "bool",
        "default": false,
        "label": "Use less memory",
        "help": "Runs the model with 8-bit weights: about a third less memory (450 MB instead of 660 MB with Standard), about a fifth slower, with a small loss of quality."
      }
    ]
  }
